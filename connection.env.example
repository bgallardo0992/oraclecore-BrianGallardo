# Plantilla de conexion. Copiar a connection.env (excluido por .gitignore) y completar.
# NO escribir contrasenas reales en este archivo ni en ningun script del repositorio.

# Oracle Database 23ai Free (imagen gvenzl/oracle-free:23.9). Para XE 21c usar XEPDB1.
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1

# Usuario administrador (solo para crear CORE_DEV con setup/00_setup_usuario.sql)
DB_ADMIN_USER=system
DB_ADMIN_PASSWORD=<clave_admin>

# Usuario de desarrollo (dueno de todos los objetos)
DB_USER=core_dev
DB_PASSWORD=<clave_core_dev>

# Contenedor Docker
DOCKER_CONTAINER=oracle-core
